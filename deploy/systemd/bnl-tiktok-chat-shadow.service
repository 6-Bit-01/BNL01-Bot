[Unit]
Description=BNL read-only TikTok LIVE chat shadow window
Wants=network-online.target
After=network-online.target
ConditionPathExists=/home/ubuntu/bnl01/.venv-tiktok-live/bin/python
ConditionPathExists=/usr/bin/tmux

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bnl01
RuntimeDirectory=bnl-tiktok-chat-shadow
RuntimeDirectoryMode=0700
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BNL_TIKTOK_ROOT=/home/ubuntu/bnl01
Environment=BNL_TIKTOK_USERNAME=six.bit
Environment=BNL_TIKTOK_TIMEZONE=America/Los_Angeles
Environment=BNL_TIKTOK_WEEKDAY=friday
Environment=BNL_TIKTOK_WINDOW_WEEKDAY_ISO=5
Environment=BNL_TIKTOK_WINDOW_START=18:50
Environment=BNL_TIKTOK_WINDOW_END=02:00
Environment=BNL_TIKTOK_RETRY_SECONDS=20
Environment=BNL_TIKTOK_LIVE_CONTEXT_PATH=/run/bnl-tiktok-chat-shadow/live-context.json
Environment=BNL_TIKTOK_LIVE_ARCHIVE_SPOOL_PATH=/run/bnl-tiktok-chat-shadow/public-conversation.ndjson
Environment=BNL_TIKTOK_TMUX_SESSION=tiktok-chat-shadow
Environment=BNL_TIKTOK_TMUX_SOCKET=/run/bnl-tiktok-chat-shadow/tmux.sock
ExecStart=/home/ubuntu/bnl01/scripts/tiktok_live_chat_shadow_service.sh
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/run/bnl-tiktok-chat-shadow
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
